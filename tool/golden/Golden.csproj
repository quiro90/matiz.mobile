<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Generador de la "tabla dorada" de paridad: compila Matiz.Core de desktop LEYENDO sus fuentes
    desde ../matiz (sin escribir nada allí) y vuelca resultados de referencia a
    packages/matiz_core/test/fixtures/golden.json. Uso: dotnet run (en tool/golden)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../matiz/src/Matiz.Core/**/*.cs" Exclude="../../../matiz/src/Matiz.Core/obj/**;../../../matiz/src/Matiz.Core/bin/**" />
  </ItemGroup>
</Project>
